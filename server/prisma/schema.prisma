datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id  String @id @default(uuid())
    firstName String
    lastName String
    phoneNo  String
    email   String  @unique
    hashedPassword   String?
    role    Role    @default(STAFF)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

enum Role {
    OWNER
    MANAGER
    STAFF
}
